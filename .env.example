# Gemini (Google AI Studio) — required for LLM thesis + chat
GEMINI_API_KEY=
# Optional alias also accepted:
# GOOGLE_API_KEY=

# Model override (defaults to gemini-3.6-flash in code)
GEMINI_MODEL=gemini-3.6-flash

# Optional Finnhub for extras (already used by data_sources)
# FINNHUB_API_KEY=

# Reddit OAuth (script app) — required for reliable ticker buzz
# Create at https://www.reddit.com/prefs/apps (type: script; redirect http://localhost:8080)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: improves User-Agent; with REDDIT_PASSWORD enables password grant fallback
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Optional User-Agent override (default: TomahawkDesk/1.0 by u/<username>)
# REDDIT_USER_AGENT=

# Shared Gemini budget (llm_trader)
# GEMINI_RPM=30
# GEMINI_DAILY=500

# ---------------------------------------------------------------------------
# Local/remote access
# ---------------------------------------------------------------------------
# The desk is unauthenticated for loopback clients. If exposing it beyond
# loopback with TOMAHAWK_HOST / TOMAHAWK_ALLOWED_HOSTS, set a long random token
# and terminate HTTPS at a trusted reverse proxy.
# Remote clients send it as X-Tomahawk-Token or Authorization: Bearer <token>.
# TOMAHAWK_AUTH_TOKEN=use-a-long-random-secret
# TOMAHAWK_TRUSTED_PROXY_HOPS=0
# Set to 1 only when directly behind one trusted HTTPS reverse proxy.
# TOMAHAWK_DEV_SERVER=0


# ---------------------------------------------------------------------------
# Tomahawk brain / Jev steals (paper research)
# ---------------------------------------------------------------------------
# Brain: gemini | mock | jev  (one selected; UI Advanced toggle also sets brain_mode)
# BRAIN_MODE=gemini
# MODEL=gemini

# Optional TypeSafe Jev lane (only when brain_mode=jev). App runs without this key.
# TYPESAFE_AI_API_KEY=
# TYPESAFE_API_KEY=

# Shadow coherence auditor (default ON). Observe-only unless SHADOW_GATE=1.
# SHADOW_AUDITOR=1
# SHADOW_GATE=0

# Horizon question for directional brain (minutes). Default 20.
# DECISION_HORIZON_MIN=20

# Optional cost estimates (USD)
# Estimates use model rates; only set overrides for your actual provider pricing.
# GEMINI_FLAT_USD_PER_CALL=0.004
# GEMINI_USD_PER_1M_INPUT=0.75
# GEMINI_USD_PER_1M_OUTPUT=3.75
# Claude call limits are persisted across restarts, like Gemini's limits.
# CLAUDE_DAILY=500
# CLAUDE_RPM=30
# Jev limits are persisted and reserved before requests, like Gemini/Claude.
# JEV_RPM=30
# JEV_DAILY=500
# JEV_FLAT_USD_PER_CALL=0.001

# ---------------------------------------------------------------------------
# Jev roundup patterns (Prism / Router / confidence) — paper research
# ---------------------------------------------------------------------------
# Prism-style advisory multi-q panel (default ON). Observe-only; never flips side.
# ADVISORY_PANEL=1
# Soft paper size cut from advisory (default OFF). risk weak → 0.5× size; KILL→hold.
# ADVISORY_SOFT_SIZE=0
# Optional: use real Gemini / Jev for advisory (default mock schema, free)
# ADVISORY_USE_GEMINI=0
# ADVISORY_USE_JEV=0

# Confidence gate: below threshold → hold / intent only (default 0.55)
# MIN_DECISION_CONFIDENCE=0.55

# Cheap brain router (default ON): weak rel_vol + range extreme OR AVOID → mock
# instead of Gemini. Set 0 to force Gemini-only when brain_mode=gemini.
# BRAIN_ROUTER=1


# ---------------------------------------------------------------------------
# Alpaca broker (optional — ALPACA_PAPER defaults true)
# ---------------------------------------------------------------------------
# Create paper keys at https://app.alpaca.markets/paper/dashboard/overview
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# Paper endpoint (DEFAULT true → https://paper-api.alpaca.markets)
# ALPACA_PAPER=true
# Set ALPACA_PAPER=false ONLY if you intentionally want api.alpaca.markets
# (LIVE money). UI shows LIVE ENDPOINT. Desk gates can_take_trade before
# submit; successful broker fills are broker-only (no dual local paper_fill).
# On broker failure, no local paper fill is created; the failure stays visible
# for reconciliation. No unlock phrase.

# Interactive Brokers Gateway (optional alternative broker)
# BROKER_PROVIDER=alpaca
# IB_GATEWAY_HOST=127.0.0.1
# 4002 paper Gateway; 4001 live Gateway.
# IB_GATEWAY_PORT=4002
# IB_CLIENT_ID=37
# Launcher finds C:\Jts\ibgateway automatically. Only set this for a custom installation:

# Soft-refresh Daily P&L every N minutes while auto_live and not risk_ready (0=off).
# Soft reconnect only — never invents risk_ready; never disables IBKR 2FA.
# IBKR_PNL_SOFT_REFRESH_MINUTES=5
# IB_GATEWAY_EXE=C:\Jts\ibgateway\1051\ibgateway.exe
# Required when Gateway exposes multiple accounts.
# IBKR_ACCOUNT=DU1234567
# Account must be a verified individual U (live) / DU (paper) account with USD base currency.
# IBKR_LIVE and standard Gateway/TWS ports must agree with the selected account.
# Set true only for an explicitly approved live account.
# IBKR_LIVE=false


# ---------------------------------------------------------------------------
# Market radar (whole-market movers — no LLM on every name)
# ---------------------------------------------------------------------------
# Enable in UI Advanced → Market radar, or POST /api/config {"radar_enabled": true}
# Prefers Alpaca snapshots when ALPACA_API_KEY/SECRET set; else Yahoo screeners;
# else Finnhub / Yahoo batch on a liquid fallback universe.
# Top N (default 20) merge into Auto paper / Ask-me-first loop focus when session on.
# Brain/LLM only runs on those selected names via the existing loop path.
# RADAR_ENABLED is not required — use config.json / UI. Optional future env hooks:
# RADAR_TOP_N=20
# RADAR_REFRESH_SEC=300


# ---------------------------------------------------------------------------
# API pack (optional — all degrade cleanly when unset)
# ---------------------------------------------------------------------------
# Polygon — snapshots + aggregates for market radar (after Alpaca, before Yahoo)
# Free/Basic is typically delayed US data with rate limits; paid unlocks real-time.
# https://polygon.io/dashboard/signup
# POLYGON_API_KEY=

# FRED — macro series / release calendar gates (Fed/CPI/NFP heuristics)
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
# Config flags (also via POST /api/config): macro_gates_enabled, macro_size_mult,
# macro_force_ask_first, macro_use_heuristics

# Finnhub — already used for quotes/news/earnings (company-news deepened in news_stream)
# https://finnhub.io/register
# FINNHUB_API_KEY=

# Benzinga news (optional stub client in news_stream.py)
# https://docs.benzinga.io/
# BENZINGA_API_KEY=
# Additional public discovery sources (no keys): Google News RSS + GDELT.
# These broaden recall and attribution; they are display-only and never gate fills.

# Social / public market pulse (research-only)
# Enable with config: social_enabled=true
# Optional comma-separated subreddit override:
# SOCIAL_SUBREDDITS=wallstreetbets,stocks,investing,options,Daytrading,Shortsqueeze
# Optional comma-separated authorized public RSS feeds. Defaults include CNBC,
# MarketWatch, NYT Business, BBC Business, and public Reddit RSS.
# SOCIAL_RSS_FEEDS=
# Licensed feeds (Reuters, Bloomberg, WSJ/Dow Jones, The Fly, X, Discord, Telegram)
# must be supplied through an authorized provider URL/API; do not scrape paywalls
# or private channels into this application.

# SEC EDGAR — free filings (User-Agent MUST include contact email)
# https://www.sec.gov/os/accessing-edgar-data
# EDGAR_USER_AGENT=TomahawkDesk/1.0 (you@example.com)

# Options flow — Advanced research only (NEVER auto-trade)
# Quiver: https://api.quiverquant.com/docs
# QUIVER_API_KEY=
# Unusual Whales: https://unusualwhales.com/information/api
# UNUSUAL_WHALES_API_KEY=

# Push alerts — Waiting / goal / kill
# Discord or Slack incoming webhook
# ALERT_WEBHOOK_URL=
# Twilio SMS stub — never sends unless ALERT_TWILIO=1 AND all TWILIO_* set
# ALERT_TWILIO=0
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_TO_NUMBER=

# Stocktwits — no key; public trending used by buzz_sources (best-effort)
# https://api.stocktwits.com/developers/docs
